<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <SolidColorBrush x:Key="Brush.BgStart" Color="#0B0714"/>
    <SolidColorBrush x:Key="Brush.BgEnd" Color="#140D24"/>
    <SolidColorBrush x:Key="Brush.Glass" Color="#1A0F28"/>
    <SolidColorBrush x:Key="Brush.GlassBorder" Color="#2D1D50"/>
    <SolidColorBrush x:Key="Brush.GlassBorderLight" Color="#3D2D60"/>
    <SolidColorBrush x:Key="Brush.Sidebar" Color="#0A0814"/>
    <SolidColorBrush x:Key="Brush.SidebarBorder" Color="#1C1040"/>
    <SolidColorBrush x:Key="Brush.BgInput" Color="#100C20"/>
    <SolidColorBrush x:Key="Brush.BgHover" Color="#1D1430"/>
    <SolidColorBrush x:Key="Brush.BgActive" Color="#2A1D4D"/>
    <SolidColorBrush x:Key="Brush.Accent" Color="#8B5CF6"/>
    <SolidColorBrush x:Key="Brush.AccentHover" Color="#9D6FFF"/>
    <SolidColorBrush x:Key="Brush.AccentSoft" Color="#2A1D4D"/>
    <SolidColorBrush x:Key="Brush.AccentText" Color="#B794FF"/>
    <SolidColorBrush x:Key="Brush.TitleBar" Color="#080614"/>
    <SolidColorBrush x:Key="Brush.Text" Color="#EDE8F5"/>
    <SolidColorBrush x:Key="Brush.TextMuted" Color="#8A7AAA"/>
    <SolidColorBrush x:Key="Brush.TextDim" Color="#584A78"/>
    <SolidColorBrush x:Key="Brush.TextLabel" Color="#9A8AB5"/>
    <SolidColorBrush x:Key="Brush.Success" Color="#22C55E"/>
    <SolidColorBrush x:Key="Brush.Warning" Color="#F59E0B"/>
    <SolidColorBrush x:Key="Brush.Error" Color="#EF4444"/>
    <SolidColorBrush x:Key="Brush.Glow" Color="#8B5CF6"/>

    <LinearGradientBrush x:Key="Brush.BgGradient" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#0B0714" Offset="0"/>
        <GradientStop Color="#140D24" Offset="0.5"/>
        <GradientStop Color="#0A0814" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="Brush.AccentGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#8B5CF6" Offset="0"/>
        <GradientStop Color="#7C3AED" Offset="1"/>
    </LinearGradientBrush>

</ResourceDictionary>
