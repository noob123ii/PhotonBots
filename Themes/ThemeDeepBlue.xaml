<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <SolidColorBrush x:Key="Brush.BgStart" Color="#070B14"/>
    <SolidColorBrush x:Key="Brush.BgEnd" Color="#0F1629"/>
    <SolidColorBrush x:Key="Brush.Glass" Color="#111A30"/>
    <SolidColorBrush x:Key="Brush.GlassBorder" Color="#1E2D50"/>
    <SolidColorBrush x:Key="Brush.GlassBorderLight" Color="#2A3D60"/>
    <SolidColorBrush x:Key="Brush.Sidebar" Color="#080C18"/>
    <SolidColorBrush x:Key="Brush.SidebarBorder" Color="#182240"/>
    <SolidColorBrush x:Key="Brush.BgInput" Color="#0C1528"/>
    <SolidColorBrush x:Key="Brush.BgHover" Color="#15203D"/>
    <SolidColorBrush x:Key="Brush.BgActive" Color="#1A2D52"/>
    <SolidColorBrush x:Key="Brush.Accent" Color="#3B82F6"/>
    <SolidColorBrush x:Key="Brush.AccentHover" Color="#4D94FF"/>
    <SolidColorBrush x:Key="Brush.AccentSoft" Color="#1A2D52"/>
    <SolidColorBrush x:Key="Brush.AccentText" Color="#8BB4F8"/>
    <SolidColorBrush x:Key="Brush.TitleBar" Color="#060A14"/>
    <SolidColorBrush x:Key="Brush.Text" Color="#E8EDF5"/>
    <SolidColorBrush x:Key="Brush.TextMuted" Color="#7A8AAB"/>
    <SolidColorBrush x:Key="Brush.TextDim" Color="#485A78"/>
    <SolidColorBrush x:Key="Brush.TextLabel" Color="#8A9AB5"/>
    <SolidColorBrush x:Key="Brush.Success" Color="#22C55E"/>
    <SolidColorBrush x:Key="Brush.Warning" Color="#F59E0B"/>
    <SolidColorBrush x:Key="Brush.Error" Color="#EF4444"/>
    <SolidColorBrush x:Key="Brush.Glow" Color="#3B82F6"/>

    <LinearGradientBrush x:Key="Brush.BgGradient" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#070B14" Offset="0"/>
        <GradientStop Color="#0F1629" Offset="0.5"/>
        <GradientStop Color="#080C18" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="Brush.AccentGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#3B82F6" Offset="0"/>
        <GradientStop Color="#2563EB" Offset="1"/>
    </LinearGradientBrush>

</ResourceDictionary>
