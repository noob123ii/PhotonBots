<Window x:Class="GtagBotUI.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:GtagBotUI.Converters"
        xmlns:ctrl="clr-namespace:GtagBotUI.Controls"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Israel Bots" Height="750" Width="1100"
        MinWidth="900" MinHeight="580"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" ResizeMode="CanResize"
        FontFamily="Segoe UI Variable Display, Segoe UI, sans-serif"
        FontSize="14"
        UseLayoutRounding="True" SnapsToDevicePixels="True">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="38" ResizeBorderThickness="5"
                            GlassFrameThickness="0" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <conv:SectionToVisibilityConverter x:Key="SectVis"/>
        <BooleanToVisibilityConverter x:Key="BoolVis"/>
        <conv:IntGreaterThanZeroToVisibilityConverter x:Key="IntGtZeroVis"/>
        <conv:StringEmptyToVisibilityConverter x:Key="StringEmptyVis"/>
    </Window.Resources>

    <Grid Background="{DynamicResource Brush.BgGradient}">
        <Grid.RowDefinitions>
            <RowDefinition Height="38"/>
            <RowDefinition Height="28"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Background decorative blobs -->
        <Ellipse Grid.RowSpan="3" Width="500" Height="500" Fill="{DynamicResource Brush.Glow}" Opacity="0.06"
                 HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-100,-100,0,0"/>
        <Ellipse Grid.RowSpan="3" Width="400" Height="400" Fill="{DynamicResource Brush.Accent}" Opacity="0.05"
                 HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-80,-80"/>
        <Ellipse Grid.RowSpan="3" Width="300" Height="300" Fill="{DynamicResource Brush.Glow}" Opacity="0.04"
                 HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-60,120,0"/>

        <!-- Particle overlay (above blobs, below content) -->
        <ctrl:ParticleOverlay Grid.RowSpan="3" Effect="{Binding SelectedBackgroundEffect}"
                              IsHitTestVisible="False" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>

        <!-- TITLE BAR -->
        <Border Grid.Row="0" Background="{DynamicResource Brush.TitleBar}"
                BorderBrush="{DynamicResource Brush.GlassBorder}"
                BorderThickness="0,0,0,1"
                MouseLeftButtonDown="TitleBar_OnMouseLeftButtonDown">
            <DockPanel LastChildFill="False">
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal"
                            Margin="16,0,0,0" VerticalAlignment="Center">
                    <Image Source="pack://application:,,,/Resources/Isreal.png" Stretch="Uniform"
                           Width="18" Height="18" Margin="0,0,10,0"
                           RenderOptions.BitmapScalingMode="HighQuality"/>
                    <TextBlock Text="ISRAEL BOTS" FontSize="13" FontWeight="Bold"
                               Foreground="{DynamicResource Brush.Text}"
                               FontFamily="Segoe UI Variable Display, Segoe UI, sans-serif"/>
                    <TextBlock Text=" / Gorilla Tag" FontSize="12" Foreground="{DynamicResource Brush.TextDim}" Margin="4,0,0,0"/>
                </StackPanel>

                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="7" Height="7" CornerRadius="4" VerticalAlignment="Center" Margin="0,0,6,0">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="{DynamicResource Brush.TextDim}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource Brush.Success}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                    </Border>
                    <TextBlock Text="{Binding StatusText}" FontSize="12" Foreground="{DynamicResource Brush.TextMuted}"
                               VerticalAlignment="Center" Margin="0,0,16,0"/>
                    <Border Width="1" Height="18" Background="{DynamicResource Brush.GlassBorder}" Margin="0,0,16,0"/>
                    <TextBlock Text="{Binding RoomName}" FontSize="12" Foreground="{DynamicResource Brush.AccentText}"
                               VerticalAlignment="Center" Margin="0,0,16,0"/>
                    <Button Style="{StaticResource ChromeButton}" Content="&#x2014;"
                            ToolTip="Minimize" Click="MinimizeClick"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
                    <Button Style="{StaticResource ChromeButton}" Content="&#x2715;"
                            ToolTip="Close" Click="CloseClick"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- HUD STATUS BAR -->
        <Border Grid.Row="1" Background="{DynamicResource Brush.AccentSoft}"
                BorderBrush="{DynamicResource Brush.GlassBorder}"
                BorderThickness="0,0,0,1"
                Padding="20,0">
            <DockPanel LastChildFill="False" VerticalAlignment="Center">
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Israel Tools" FontSize="11" FontWeight="SemiBold"
                               Foreground="{DynamicResource Brush.AccentText}" VerticalAlignment="Center"/>
                    <TextBlock Text="|" FontSize="10" Foreground="{DynamicResource Brush.TextDim}"
                               VerticalAlignment="Center" Margin="8,0"/>
                    <TextBlock Text="Version 1.0.0" FontSize="10"
                               Foreground="{DynamicResource Brush.TextMuted}" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Bots Running:" FontSize="10"
                               Foreground="{DynamicResource Brush.TextDim}" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding HudBotsText}" FontSize="10" FontWeight="SemiBold"
                               Foreground="{DynamicResource Brush.AccentText}" VerticalAlignment="Center" Margin="4,0,12,0"/>
                    <Border Width="1" Height="14" Background="{DynamicResource Brush.GlassBorder}" Margin="0,0,12,0"/>
                    <TextBlock Text="Total Tracks:" FontSize="10"
                               Foreground="{DynamicResource Brush.TextDim}" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding HudTracksText}" FontSize="10" FontWeight="Bold"
                               Foreground="{DynamicResource Brush.Success}" VerticalAlignment="Center" Margin="4,0,0,0"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- MAIN -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- SIDEBAR -->
            <Border Grid.Column="0" Background="{DynamicResource Brush.Sidebar}"
                    BorderBrush="{DynamicResource Brush.SidebarBorder}"
                    BorderThickness="0,0,1,0">
                <Grid Margin="0,20,0,16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Brand -->
                    <StackPanel Grid.Row="0" Margin="16,0,16,20">
                        <StackPanel Orientation="Horizontal">
                            <Image Source="pack://application:,,,/Resources/Isreal.png" Stretch="Uniform"
                                   Width="38" Height="38" Margin="0,0,12,0"
                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="ISRAEL BOTS" FontSize="14" FontWeight="Bold"
                                           Foreground="{DynamicResource Brush.AccentText}"/>
                                <TextBlock Text="v1.0.0" FontSize="10" Foreground="{DynamicResource Brush.TextDim}"/>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>

                    <Border Grid.Row="1" Style="{StaticResource SeparatorLine}" Margin="16,0,16,10"/>
                    <TextBlock Grid.Row="1" Text="NAVIGATION" Foreground="{DynamicResource Brush.TextDim}"
                               FontSize="10" FontWeight="SemiBold" Margin="16,0,0,6"/>

                    <!-- Nav items (Segoe MDL2 Assets glyphs) -->
                    <ListBox Grid.Row="2" ItemsSource="{Binding NavItems}"
                             SelectedValue="{Binding SelectedSection, Mode=TwoWay}"
                             SelectedValuePath="Section"
                             ItemContainerStyle="{StaticResource NavItemStyle}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="24"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding Glyph}"
                                               FontFamily="Segoe MDL2 Assets" FontSize="15"
                                               Foreground="{DynamicResource Brush.TextMuted}"
                                               VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Title}" FontSize="13"
                                               VerticalAlignment="Center" Margin="10,0,0,0"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- Footer stats -->
                    <StackPanel Grid.Row="3" Margin="16,0,16,0">
                        <Border Style="{StaticResource SeparatorLine}" Margin="0,0,0,12"/>
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Width="7" Height="7" CornerRadius="4" VerticalAlignment="Center">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="{DynamicResource Brush.TextDim}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource Brush.Success}"/>
                                                <Setter Property="Effect">
                                                    <Setter.Value>
                                                        <DropShadowEffect ShadowDepth="0" BlurRadius="6" Opacity="0.5" Color="#22C55E"/>
                                                    </Setter.Value>
                                                </Setter>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                            </Border>
                            <TextBlock Grid.Column="1" Text="Connected" FontSize="11" Margin="9,0,0,0"
                                       Foreground="{DynamicResource Brush.TextMuted}" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="2" Text="{Binding LogCount, StringFormat={}{0} ev}"
                                       FontSize="11" Foreground="{DynamicResource Brush.TextDim}"/>
                        </Grid>
                        <TextBlock Text="{Binding BotCount, StringFormat={}Bots: {0}}"
                                   FontSize="11" Foreground="{DynamicResource Brush.TextDim}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- CONTENT -->
            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled" Padding="28,20,28,20">
                <StackPanel>

                    <!-- ====== DASHBOARD ====== -->
                    <StackPanel Visibility="{Binding SelectedSection, Converter={StaticResource SectVis}, ConverterParameter=Dashboard}">
                        <TextBlock Text="BOT OVERVIEW" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{DynamicResource Brush.AccentText}" Margin="0,0,0,14"/>

                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Total Accounts -->
                            <Border Grid.Column="0" Style="{StaticResource MetricCard}">
                                <StackPanel>
                                    <Path Data="M8,3 C10.2,3 12,4.8 12,7 C12,9.2 10.2,11 8,11 C5.8,11 4,9.2 4,7 C4,4.8 5.8,3 8,3 Z M2,16 C2,16 5,11 8,11 C11,11 14,16 14,16 Z"
                                          Fill="{DynamicResource Brush.Accent}" Stretch="Uniform" Width="24" Height="24"
                                          HorizontalAlignment="Left" Margin="0,0,0,10"/>
                                    <TextBlock Text="{Binding TotalAccounts}" FontSize="26" FontWeight="Bold"
                                               Foreground="{DynamicResource Brush.AccentText}" Margin="0,0,0,4"
                                               FontFamily="Segoe UI Variable Display, Segoe UI, sans-serif"/>
                                    <TextBlock Text="Total Accounts" FontSize="11" Foreground="{DynamicResource Brush.TextDim}"/>
                                </StackPanel>
                            </Border>

                            <!-- Valid Accounts -->
                            <Border Grid.Column="1" Style="{StaticResource MetricCard}" Margin="10,0,0,0">
                                <StackPanel>
                                    <Path Data="M8,1 L14,3 L14,9 C14,13 8,16 8,16 C8,16 2,13 2,9 L2,3 Z M5,8 L7,10 L11,5"
                                          Fill="{DynamicResource Brush.Success}" Stretch="Uniform" Width="24" Height="24"
                                          HorizontalAlignment="Left" Margin="0,0,0,10"/>
                                    <TextBlock Text="{Binding ValidAccounts}" FontSize="26" FontWeight="Bold"
                                               Foreground="{DynamicResource Brush.Success}" Margin="0,0,0,4"
                                               FontFamily="Segoe UI Variable Display, Segoe UI, sans-serif"/>
                                    <TextBlock Text="Valid Accounts" FontSize="11" Foreground="{DynamicResource Brush.TextDim}"/>
                                </StackPanel>
                            </Border>

                            <!-- Room -->
                            <Border Grid.Column="2" Style="{StaticResource MetricCard}" Margin="10,0,0,0">
                                <StackPanel>
                                    <Path Data="M2,8 L8,2 L14,8 M4,6 L4,13 L10,13 L10,9 M10,13 L14,13 L14,8"
                                          Fill="{DynamicResource Brush.AccentText}" Stretch="Uniform" Width="24" Height="24"
                                          HorizontalAlignment="Left" Margin="0,0,0,10"/>
                                    <TextBlock Text="{Binding DashboardRoom}" FontSize="20" FontWeight="Bold"
                                               Foreground="{DynamicResource Brush.AccentText}" Margin="0,0,0,4"
                                               FontFamily="Cascadia Code, Consolas, monospace"/>
                                    <TextBlock Text="Room" FontSize="11" Foreground="{DynamicResource Brush.TextDim}"/>
                                </StackPanel>
                            </Border>

                            <!-- Session -->
                            <Border Grid.Column="3" Style="{StaticResource MetricCard}" Margin="10,0,0,0">
                                <StackPanel>
                                    <Path Data="M8,1 C11.9,1 15,4.1 15,8 C15,11.9 11.9,15 8,15 C4.1,15 1,11.9 1,8 C1,4.1 4.1,1 8,1 Z M8,4 L8,8 L11,10"
                                          Fill="{DynamicResource Brush.AccentText}" Stretch="Uniform" Width="24" Height="24"
                                          HorizontalAlignment="Left" Margin="0,0,0,10"/>
                                    <TextBlock Text="{Binding SessionTime}" FontSize="20" FontWeight="Bold"
                                               Foreground="{DynamicResource Brush.Text}" Margin="0,0,0,4"
                                               FontFamily="Cascadia Code, Consolas, monospace"/>
                                    <TextBlock Text="Session" FontSize="11" Foreground="{DynamicResource Brush.TextDim}"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Border Style="{StaticResource GlassCard}" Padding="0"
                                Background="{DynamicResource Brush.AccentSoft}">
                            <Grid Margin="20,16,20,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Width="44" Height="44" CornerRadius="11"
                                        Background="{DynamicResource Brush.AccentGradient}" VerticalAlignment="Center">
                                    <Path Data="M10,2 L18,18 L2,18 Z M10,18 L18,2 L2,2 Z"
                                          Fill="White" Stretch="Uniform" Width="24" Height="24"/>
                                </Border>
                                <StackPanel Grid.Column="1" Margin="16,0,16,0" VerticalAlignment="Center">
                                    <TextBlock Text="Welcome to Israel Bots" FontSize="15" FontWeight="SemiBold"
                                               Foreground="{DynamicResource Brush.AccentText}"/>
                                    <TextBlock Text="Manage your Gorilla Tag bots from one control panel."
                                               Foreground="{DynamicResource Brush.TextMuted}" FontSize="12" Margin="0,2,0,0"/>
                                </StackPanel>
                                <Button Grid.Column="2" Content="Verify Accounts" Command="{Binding VerifyAccountsCommand}"
                                        Style="{StaticResource PrimaryButton}" Padding="16,8" FontSize="12" MinWidth="0"
                                        VerticalAlignment="Center"/>
                                <Button Grid.Column="4" Content="Check Bans" Command="{Binding CheckBansCommand}"
                                        Style="{StaticResource PrimaryButton}" Padding="16,8" FontSize="12" MinWidth="0"
                                        VerticalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <!-- Ban Check Live Status -->
                        <Border Style="{StaticResource GlassCard}"
                                Visibility="{Binding IsCheckRunning, Converter={StaticResource BoolVis}}">
                            <StackPanel>
                                <TextBlock FontSize="11" FontWeight="SemiBold"
                                           Foreground="{DynamicResource Brush.AccentText}" Margin="0,0,0,10">
                                    CHECKING BANS
                                </TextBlock>
                                <TextBlock FontSize="13" Foreground="{DynamicResource Brush.Text}" Margin="0,0,0,8"
                                           TextTrimming="CharacterEllipsis">
                                    <Run Text="Checking:" FontWeight="SemiBold"/>
                                    <Run Text="{Binding CheckCurrent}" Foreground="{DynamicResource Brush.AccentText}"/>
                                </TextBlock>
                                <ProgressBar Value="{Binding BanCheckProgress}" Maximum="{Binding BanCheckProgressMax}"
                                             Height="6" Margin="0,0,0,8"/>
                                <TextBlock FontSize="11" Foreground="{DynamicResource Brush.TextMuted}" Margin="0,0,0,8"
                                           Visibility="{Binding CheckProxyTotal, Converter={StaticResource IntGtZeroVis}}">
                                    <Run Text="Proxies:" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextDim}"/>
                                    <Run Text="{Binding CheckProxyAlive}" Foreground="{DynamicResource Brush.Success}"/>
                                    <Run Text="/" Foreground="{DynamicResource Brush.TextMuted}"/>
                                    <Run Text="{Binding CheckProxyTotal}" Foreground="{DynamicResource Brush.AccentText}"/>
                                    <Run Text="alive" Foreground="{DynamicResource Brush.TextMuted}"/>
                                </TextBlock>
                                <Grid TextBlock.FontSize="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{Binding UnbannedAccounts}" FontSize="20" FontWeight="Bold"
                                                   Foreground="{DynamicResource Brush.Success}"/>
                                        <TextBlock Text="OK" Foreground="{DynamicResource Brush.TextMuted}" FontSize="10"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{Binding BannedAccounts}" FontSize="20" FontWeight="Bold"
                                                   Foreground="{DynamicResource Brush.Error}"/>
                                        <TextBlock Text="BANNED" Foreground="{DynamicResource Brush.TextMuted}" FontSize="10"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="{Binding FailedAccounts}" FontSize="20" FontWeight="Bold"
                                                   Foreground="{DynamicResource Brush.Warning}"/>
                                        <TextBlock Text="FAILED" Foreground="{DynamicResource Brush.TextMuted}" FontSize="10"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="3">
                                        <TextBlock Text="{Binding InvalidAccounts}" FontSize="20" FontWeight="Bold"
                                                   Foreground="{DynamicResource Brush.TextDim}"/>
                                        <TextBlock Text="INVALID" Foreground="{DynamicResource Brush.TextMuted}" FontSize="10"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="4">
                                        <TextBlock Text="{Binding CheckPercent, StringFormat={}{0}%}" FontSize="20" FontWeight="Bold"
                                                   Foreground="{DynamicResource Brush.AccentText}"/>
                                        <TextBlock Text="PROGRESS" Foreground="{DynamicResource Brush.TextMuted}" FontSize="10"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Ban Check Results -->
                        <Border Style="{StaticResource GlassCard}"
                                Visibility="{Binding HasCheckedResults, Converter={StaticResource BoolVis}}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="{Binding UnbannedAccounts}" FontSize="22" FontWeight="Bold"
                                               Foreground="{DynamicResource Brush.Success}" Margin="0,0,0,2"/>
                                    <TextBlock Text="UNBANNED / OK" FontSize="10" Foreground="{DynamicResource Brush.TextDim}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{Binding BannedAccounts}" FontSize="22" FontWeight="Bold"
                                               Foreground="{DynamicResource Brush.Error}" Margin="0,0,0,2"/>
                                    <TextBlock Text="BANNED" FontSize="10" Foreground="{DynamicResource Brush.TextDim}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="{Binding FailedAccounts}" FontSize="22" FontWeight="Bold"
                                               Foreground="{DynamicResource Brush.Warning}" Margin="0,0,0,2"/>
                                    <TextBlock Text="FAILED" FontSize="10" Foreground="{DynamicResource Brush.TextDim}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="3">
                                    <TextBlock Text="{Binding InvalidAccounts}" FontSize="22" FontWeight="Bold"
                                               Foreground="{DynamicResource Brush.TextDim}" Margin="0,0,0,2"/>
                                    <TextBlock Text="INVALID" FontSize="10" Foreground="{DynamicResource Brush.TextDim}"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </StackPanel>

                    <!-- ====== BOT CONTROL ====== -->
                    <StackPanel Visibility="{Binding SelectedSection, Converter={StaticResource SectVis}, ConverterParameter=BotControl}">
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="320"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Style="{StaticResource GlassCard}" Margin="0,0,12,0">
                                <StackPanel>
                                    <TextBlock Text="BOT CONFIGURATION" FontSize="11" FontWeight="SemiBold"
                                               Foreground="{DynamicResource Brush.AccentText}" Margin="0,0,0,16"/>

                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="12"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="12"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Room" FontSize="12" Foreground="{DynamicResource Brush.TextLabel}" Margin="0,0,0,4"/>
                                            <Grid>
                                                <TextBlock Text="Enter room code..." FontSize="13"
                                                           Foreground="{DynamicResource Brush.TextDim}"
                                                           IsHitTestVisible="False" VerticalAlignment="Center"
                                                           Margin="12,0,0,0"
                                                           Visibility="{Binding RoomName, Converter={StaticResource StringEmptyVis}}"/>
                                                <TextBox Text="{Binding RoomName}"/>
                                            </Grid>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="Name" FontSize="12" Foreground="{DynamicResource Brush.TextLabel}" Margin="0,0,0,4"/>
                                            <Grid>
                                                <TextBlock Text="Bot nickname..." FontSize="13"
                                                           Foreground="{DynamicResource Brush.TextDim}"
                                                           IsHitTestVisible="False" VerticalAlignment="Center"
                                                           Margin="12,0,0,0"
                                                           Visibility="{Binding Nickname, Converter={StaticResource StringEmptyVis}}"/>
                                                <TextBox Text="{Binding Nickname}"/>
                                            </Grid>
                                        </StackPanel>
                                        <StackPanel Grid.Column="4">
                                            <TextBlock Text="Region" FontSize="12" Foreground="{DynamicResource Brush.TextLabel}" Margin="0,0,0,4"/>
                                            <ComboBox ItemsSource="{Binding Regions}" SelectedItem="{Binding SelectedRegion}"/>
                                        </StackPanel>
                                    </Grid>

                                    <Border Style="{StaticResource SeparatorLine}" Margin="0,0,0,14"/>

                                    <Grid Margin="0,0,0,14">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="160"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Bot Amount" FontSize="12" Foreground="{DynamicResource Brush.TextLabel}" Margin="0,0,0,6"/>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="34"/>
                                                    <ColumnDefinition Width="64"/>
                                                    <ColumnDefinition Width="34"/>
                                                </Grid.ColumnDefinitions>
                                                <Border Grid.Column="0" CornerRadius="8,0,0,8"
                                                        Style="{StaticResource SpinnerButton}"
                                                        BorderThickness="1,1,0,1">
                                                    <Button Content="&#x2212;" FontSize="16" FontWeight="Bold"
                                                            Background="Transparent" BorderThickness="0"
                                                            Foreground="{DynamicResource Brush.Text}"
                                                            HorizontalAlignment="Center" VerticalAlignment="Center"
                                                            Padding="0" MinWidth="0"
                                                            Click="DecrementBotCount"/>
                                                </Border>
                                                <Border Grid.Column="1" Background="{DynamicResource Brush.BgInput}"
                                                        BorderBrush="{DynamicResource Brush.GlassBorder}" BorderThickness="0,1" Padding="0,8">
                                                    <TextBox Text="{Binding BotCountText}"
                                                             HorizontalAlignment="Center" FontSize="16"
                                                             FontWeight="Bold" Foreground="{DynamicResource Brush.AccentText}"
                                                             Background="Transparent" BorderThickness="0"
                                                             TextAlignment="Center" Padding="0" MinWidth="36"
                                                             MaxLength="3" MinHeight="0" Height="Auto"/>
                                                </Border>
                                                <Border Grid.Column="2" CornerRadius="0,8,8,0"
                                                        Style="{StaticResource SpinnerButton}"
                                                        BorderThickness="0,1,1,1">
                                                    <Button Content="+" FontSize="16" FontWeight="Bold"
                                                            Background="Transparent" BorderThickness="0"
                                                            Foreground="{DynamicResource Brush.Text}"
                                                            HorizontalAlignment="Center" VerticalAlignment="Center"
                                                            Padding="0" MinWidth="0"
                                                            Click="IncrementBotCount"/>
                                                </Border>
                                            </Grid>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="16,6,0,0">
                                            <TextBlock Text="{Binding ValidAccounts, StringFormat={}Max: {0} valid accounts}" FontSize="12"
                                                       Foreground="{DynamicResource Brush.TextMuted}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Grid>

                                    <Border Style="{StaticResource SeparatorLine}" Margin="0,0,0,14"/>

                                    <StackPanel Margin="0,0,0,12">
                                        <TextBlock Text="MOVEMENT" FontSize="11" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource Brush.AccentText}" Margin="0,0,0,10"/>
                                        <CheckBox IsChecked="{Binding EnableFollow}" Content="Enable movement" Margin="0,0,0,10"/>
                                        <StackPanel Visibility="{Binding EnableFollow, Converter={StaticResource BoolVis}}">
                                            <TextBlock Text="Movement modes (multi-select)" FontSize="11"
                                                       Foreground="{DynamicResource Brush.TextLabel}" Margin="0,0,0,6"/>
                                            <ItemsControl ItemsSource="{Binding MoveModeOptions}" Margin="0,0,0,8">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <WrapPanel/>
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <ToggleButton Content="{Binding Label}"
                                                                      IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                                      Style="{StaticResource MoveChip}"
                                                                      ToolTip="{Binding Description}"/>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <Border Background="{DynamicResource Brush.AccentSoft}"
                                                    CornerRadius="8" Padding="10,8" Margin="0,0,0,10"
                                                    BorderBrush="{DynamicResource Brush.GlassBorder}" BorderThickness="1">
                                                <TextBlock Text="{Binding MoveModeDescription}" FontSize="11"
                                                           Foreground="{DynamicResource Brush.TextMuted}" TextWrapping="Wrap"/>
                                            </Border>
                                            <TextBlock Text="Target player" FontSize="11"
                                                       Foreground="{DynamicResource Brush.TextLabel}" Margin="0,0,0,4"/>
                                            <Grid>
                                                <TextBlock Text="Name (optional for Cycle)..." FontSize="12"
                                                           Foreground="{DynamicResource Brush.TextDim}"
                                                           IsHitTestVisible="False" VerticalAlignment="Center"
                                                           Margin="12,0,0,0"
                                                           Visibility="{Binding FollowTarget, Converter={StaticResource StringEmptyVis}}"/>
                                                <TextBox Text="{Binding FollowTarget}"/>
                                            </Grid>
                                        </StackPanel>
                                    </StackPanel>

                                    <StackPanel Margin="0,0,0,12">
                                        <CheckBox IsChecked="{Binding PlaySound}" Content="Play Sound" Margin="0,0,0,8"/>
                                        <StackPanel Margin="4,0,0,0"
                                                    Visibility="{Binding PlaySound, Converter={StaticResource BoolVis}}">
                                            <Grid Margin="0,0,0,10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="8"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="8"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <ComboBox Grid.Column="0"
                                                          ItemsSource="{Binding AvailableSounds}"
                                                          SelectedItem="{Binding SelectedSound}"
                                                          IsTextSearchEnabled="True"
                                                          ToolTip="Select a sound from the soundboard"/>
                                                <Button Grid.Column="2" Content="Browse" Style="{StaticResource SmallButton}" Click="BrowseSound"/>
                                                <Button Grid.Column="4" Content="Preview" Style="{StaticResource SmallButton}" Click="PreviewSound"/>
                                            </Grid>
                                            <Border Background="{DynamicResource Brush.BgInput}"
                                                    BorderBrush="{DynamicResource Brush.GlassBorder}" BorderThickness="1"
                                                    CornerRadius="10" Padding="12,10">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="Volume" FontSize="11" FontWeight="SemiBold"
                                                               Foreground="{DynamicResource Brush.TextLabel}"
                                                               VerticalAlignment="Center" Margin="0,0,12,0"/>
                                                    <Slider Grid.Column="1" Minimum="0" Maximum="1"
                                                            Value="{Binding SoundVolume}" SmallChange="0.05"
                                                            LargeChange="0.2" TickFrequency="0.1"
                                                            IsSnapToTickEnabled="False"
                                                            VerticalAlignment="Center"
                                                            ToolTip="{Binding SoundVolume, StringFormat={}{0:P0}}"/>
                                                    <Border Grid.Column="2" MinWidth="48" CornerRadius="6" Padding="8,4"
                                                            Background="{DynamicResource Brush.AccentSoft}"
                                                            BorderBrush="{DynamicResource Brush.GlassBorder}" BorderThickness="1"
                                                            Margin="12,0,0,0" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding SoundVolume, StringFormat={}{0:P0}}"
                                                                   FontSize="12" FontWeight="Bold"
                                                                   Foreground="{DynamicResource Brush.AccentText}"
                                                                   HorizontalAlignment="Center"/>
                                                    </Border>
                                                </Grid>
                                            </Border>
                                        </StackPanel>
                                    </StackPanel>

                                    <StackPanel Margin="0,0,0,12">
                                        <CheckBox IsChecked="{Binding EnableCustomEvent}" Content="Custom Event Code" Margin="0,0,0,8"/>
                                        <TextBox Text="{Binding CustomEventCode}"
                                                 Visibility="{Binding EnableCustomEvent, Converter={StaticResource BoolVis}}"
                                                 AcceptsReturn="True" MinHeight="50" FontFamily="Cascadia Code, Consolas, monospace" FontSize="11"
                                                 Margin="4,0,0,0"/>
                                    </StackPanel>

                                    <Border Style="{StaticResource SeparatorLine}" Margin="0,0,0,14"/>

                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="  Start Bots" Command="{Binding StartBotCommand}"
                                                Style="{StaticResource PrimaryButton}" IsEnabled="{Binding CanStart}" Margin="0,0,8,0"/>
                                        <Button Content="  Stop Bots" Command="{Binding StopBotCommand}"
                                                Style="{StaticResource SecondaryButton}" IsEnabled="{Binding IsRunning}"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="1" Style="{StaticResource GlassCard}">
                                <StackPanel>
                                    <TextBlock Text="BOT STATUS" FontSize="11" FontWeight="SemiBold"
                                               Foreground="{DynamicResource Brush.AccentText}" Margin="0,0,0,16"/>
                                    <StackPanel Margin="0,0,0,16">
                                        <StackPanel Orientation="Horizontal">
                                            <Border Width="10" Height="10" CornerRadius="5" VerticalAlignment="Center">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="{DynamicResource Brush.TextDim}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                                                <Setter Property="Background" Value="{DynamicResource Brush.Success}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                            </Border>
                                            <TextBlock Text="{Binding StatusText}" FontSize="18" FontWeight="Bold"
                                                       Foreground="{DynamicResource Brush.Text}" Margin="10,0,0,0"/>
                                        </StackPanel>
                                    </StackPanel>
                                    <Border Style="{StaticResource SeparatorLine}" Margin="0,0,0,12"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Bots" FontSize="12" Foreground="{DynamicResource Brush.TextMuted}"/>
                                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding BotCount, StringFormat={}{0} bots}" FontSize="12" FontWeight="SemiBold"/>
                                        <Border Grid.Row="1" Grid.ColumnSpan="2" Style="{StaticResource SeparatorLine}" Margin="0,8,0,8"/>
                                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Network" FontSize="12" Foreground="{DynamicResource Brush.TextMuted}"/>
                                        <TextBlock Grid.Row="2" Grid.Column="1" Text="Stable" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Success}"/>
                                        <Border Grid.Row="3" Grid.ColumnSpan="2" Style="{StaticResource SeparatorLine}" Margin="0,8,0,8"/>
                                        <TextBlock Grid.Row="4" Grid.Column="0" Text="Room" FontSize="12" Foreground="{DynamicResource Brush.TextMuted}"/>
                                        <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding RoomName}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Brush.AccentText}"/>
                                    </Grid>
                                    <Border Style="{StaticResource SeparatorLine}" Margin="0,0,12,0"/>
                                    <StackPanel Margin="0,12,0,0">
                                        <TextBlock Text="Total Tracks" FontSize="11" Foreground="{DynamicResource Brush.TextDim}"/>
                                        <TextBlock Text="{Binding TotalTracks}" FontSize="24" FontWeight="Bold"
                                                   Foreground="{DynamicResource Brush.Success}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- Public Scanner Card -->
                        <Border Style="{StaticResource GlassCard}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="PUBLIC ROOM SCANNER" FontSize="11" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource Brush.AccentText}"/>
                                            <TextBlock Text="Send 1 bot to scan rooms — tracks player cosmetics from target list"
                                                       FontSize="11" Foreground="{DynamicResource Brush.TextDim}"/>
                                        </StackPanel>
                                    </StackPanel>
                                </StackPanel>
                                <Button Grid.Column="1" Command="{Binding StartScanCommand}"
                                        Padding="16,8" FontSize="12" MinWidth="120" VerticalAlignment="Center">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
                                            <Setter Property="Content" Value="Start Scanning"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsScanRunning}" Value="True">
                                                    <Setter Property="Content" Value="Stop Scanning"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </Grid>
                        </Border>
                    </StackPanel>

                    <!-- ====== ACTIVITY LOG ====== -->
                    <StackPanel Visibility="{Binding SelectedSection, Converter={StaticResource SectVis}, ConverterParameter=Log}">
                        <Border Style="{StaticResource GlassCard}" Padding="0">
                            <Grid>
                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                                <Border Grid.Row="0" Padding="18,12,18,12" BorderBrush="{DynamicResource Brush.GlassBorder}" BorderThickness="0,0,0,1">
                                    <Grid>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="ACTIVITY LOG" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Brush.AccentText}" VerticalAlignment="Center"/>
                                            <Border Background="{DynamicResource Brush.BgInput}" CornerRadius="6" Padding="8,4,8,4" Margin="10,0,0,0"
                                                    BorderBrush="{DynamicResource Brush.GlassBorder}" BorderThickness="1">
                                                <TextBlock Text="{Binding LogCount, StringFormat={}{0} events}" FontSize="11" Foreground="{DynamicResource Brush.TextMuted}"/>
                                            </Border>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                            <Button Content="Copy" Command="{Binding CopyLogCommand}" Style="{StaticResource SmallButton}" Margin="0,0,6,0"/>
                                            <Button Content="Clear" Command="{Binding ClearLogCommand}" Style="{StaticResource SmallButton}"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                                <Border Grid.Row="1" Background="#090909" MinHeight="520" CornerRadius="0,0,12,12">
                                    <ListBox x:Name="LogList" ItemsSource="{Binding LogEntries}" Background="Transparent" BorderThickness="0" Padding="8,4"
                                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                             ScrollViewer.VerticalScrollBarVisibility="Hidden"
                                             ScrollViewer.PanningMode="VerticalOnly"
                                             ScrollViewer.CanContentScroll="True"
                                             BorderBrush="{x:Null}">
                                        <ListBox.ItemContainerStyle>
                                            <Style TargetType="ListBoxItem">
                                                <Setter Property="Background" Value="Transparent"/><Setter Property="Padding" Value="0"/>
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="ListBoxItem">
                                                            <ContentPresenter/>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </ListBox.ItemContainerStyle>
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,0,0,1">
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="3"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                    <Border Grid.Column="0" Width="3" Height="14" CornerRadius="2" Margin="0,0,8,0" VerticalAlignment="Center">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Background" Value="{DynamicResource Brush.TextDim}"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Level}" Value="1"><Setter Property="Background" Value="{DynamicResource Brush.Warning}"/></DataTrigger>
                                                                    <DataTrigger Binding="{Binding Level}" Value="2"><Setter Property="Background" Value="{DynamicResource Brush.Error}"/></DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                    </Border>
                                                    <Border Grid.Column="1" MinWidth="18" Height="14" CornerRadius="3"
                                                            Background="{DynamicResource Brush.AccentSoft}" Margin="0,1,6,1"
                                                            Visibility="{Binding Count, Converter={StaticResource IntGtZeroVis}, ConverterParameter=1}">
                                                        <TextBlock Text="{Binding Count}" FontSize="9" FontWeight="Bold"
                                                                   Foreground="{DynamicResource Brush.AccentText}"
                                                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                   Margin="3,0"/>
                                                    </Border>
                                                    <TextBlock Grid.Column="2" FontFamily="Cascadia Code, Consolas, monospace" FontSize="11" TextWrapping="NoWrap" Padding="0,1">
                                                        <Run Text="[" Foreground="{DynamicResource Brush.TextDim}"/>
                                                        <Run Text="{Binding Timestamp}" Foreground="{DynamicResource Brush.TextDim}"/>
                                                        <Run Text="]" Foreground="{DynamicResource Brush.TextDim}"/>
                                                        <Run Text=" " Foreground="{DynamicResource Brush.TextDim}"/>
                                                        <Run Text="{Binding Message}" Foreground="{DynamicResource Brush.Text}"/>
                                                    </TextBlock>
                                                </Grid>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </Border>
                            </Grid>
                        </Border>
                    </StackPanel>

                    <!-- ====== SETTINGS ====== -->
                    <StackPanel Visibility="{Binding SelectedSection, Converter={StaticResource SectVis}, ConverterParameter=Settings}">
                        <TextBlock Text="SETTINGS" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Brush.AccentText}" Margin="0,0,0,12"/>

                        <Border Style="{StaticResource GlassCard}">
                            <StackPanel>
                                <TextBlock Text="General" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource Brush.AccentText}" Margin="0,0,0,14"/>
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="160"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Startup" FontSize="13" VerticalAlignment="Center"/>
                                    <CheckBox Grid.Row="0" Grid.Column="1" Content="Auto connect on launch" IsChecked="{Binding AutoConnect}" Margin="0,0,0,8"/>
                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Theme" FontSize="13" VerticalAlignment="Center"/>
                                    <ComboBox Grid.Row="1" Grid.Column="1"
                                              ItemsSource="{Binding ThemeNames}"
                                              SelectedItem="{Binding SelectedTheme}"
                                              HorizontalAlignment="Left" MinWidth="150"/>
                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Webhook URL" FontSize="13" VerticalAlignment="Center"/>
                                    <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding WebhookUrl}" MinWidth="300"
                                             HorizontalAlignment="Left"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource GlassCard}">
                            <StackPanel>
                                <TextBlock Text="Network" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource Brush.AccentText}" Margin="0,0,0,14"/>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="160"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="Default Region" FontSize="13" VerticalAlignment="Center"/>
                                    <ComboBox Grid.Column="1" ItemsSource="{Binding Regions}" SelectedItem="{Binding SelectedRegion}"
                                              HorizontalAlignment="Left" MinWidth="150"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource GlassCard}">
                            <StackPanel>
                                <TextBlock Text="Bot Delays" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource Brush.AccentText}" Margin="0,0,0,14"/>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="160"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="Join delay (ms)" FontSize="13" VerticalAlignment="Center"/>
                                    <TextBox Grid.Column="1" Text="{Binding MinDelayText}" MinWidth="90" Margin="0,0,8,0"/>
                                    <TextBlock Grid.Column="2" FontSize="13" VerticalAlignment="Center">
                                        <Run Text="to" FontSize="12" Foreground="{DynamicResource Brush.TextDim}"/>
                                    </TextBlock>
                                    <TextBox Grid.Column="2" Text="{Binding MaxDelayText}" MinWidth="90" Margin="30,0,0,0"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource GlassCard}">
                            <StackPanel>
                                <TextBlock Text="Proxy" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource Brush.AccentText}" Margin="0,0,0,14"/>
                                <TextBlock FontSize="12" Foreground="{DynamicResource Brush.TextMuted}" Margin="0,0,0,12"
                                           Text="Proxies are embedded in src/proxies.js (1654 http/socks5). Used round-robin for all requests." TextWrapping="Wrap"/>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="160"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="Proxies loaded" FontSize="13" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="{Binding ProxyCount, StringFormat={}{0} proxies}" FontSize="13"
                                               Foreground="{DynamicResource Brush.AccentText}" FontWeight="SemiBold"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource GlassCard}">
                            <StackPanel>
                                <TextBlock Text="Visual Effects" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource Brush.AccentText}" Margin="0,0,0,14"/>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="160"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="Background" FontSize="13" VerticalAlignment="Center"/>
                                    <ComboBox Grid.Column="1"
                                              ItemsSource="{Binding BackgroundEffectNames}"
                                              SelectedItem="{Binding SelectedBackgroundEffectName}"
                                              HorizontalAlignment="Left" MinWidth="160"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                    </StackPanel>

                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
